#!/usr/bin/env php
<?php

define('LARAVEL_START', microtime(true));

$args = array_slice($argv, 1);
$command = $args[0] ?? 'serve';

if ($command === 'serve') {
    $host = '127.0.0.1';
    $port = 8000;

    foreach ($args as $arg) {
        if (strpos($arg, '--port=') === 0) {
            $port = (int) substr($arg, 7);
        } elseif (strpos($arg, '--host=') === 0) {
            $host = substr($arg, 7);
        }
    }

    echo "\n";
    echo "   INFO  Server running on [http://{$host}:{$port}].\n\n";
    echo "  Press Ctrl+C to stop the server\n\n";

    $php = PHP_BINARY;
    $cmd = "\"{$php}\" -S {$host}:{$port} server.php";
    passthru($cmd);
    exit(0);
}

echo "PAUD-KB Nurul Ilmi CLI\n";
echo "Usage: php artisan serve [--port=8000] [--host=127.0.0.1]\n";
exit(0);

